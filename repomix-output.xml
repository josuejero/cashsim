<file path="docker-compose.yml">
name: cashsim

services:
  api:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["cashsim", "api", "--host", "0.0.0.0", "--port", "8000"]
    environment:
      # Turn on OTel for the API and send spans to the Collector
      CASHSIM_OTEL_ENABLED: "true"
      OTEL_SERVICE_NAME: "cashsim-api"
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4317"
      OTEL_EXPORTER_OTLP_PROTOCOL: "grpc"
      OTEL_EXPORTER_OTLP_INSECURE: "true"

      # Logging
      LOG_LEVEL: "INFO"
      LOG_FORMAT: "json"

      # Optional: set if you add explicit sampling controls
      # OTEL_TRACES_SAMPLER: "parentbased_traceidratio"
      # OTEL_TRACES_SAMPLER_ARG: "1.0"

    ports:
      - "8000:8000"
    depends_on:
      - otel-collector
    healthcheck:
      test:
        [
          "CMD",
          "bash",
          "-lc",
          'python -c "import urllib.request; urllib.request.urlopen(''http://localhost:8000/v1/health'').read()"',
        ]
      interval: 10s
      timeout: 3s
      retries: 10

  ui:
    build:
      context: .
      dockerfile: Dockerfile
    # Streamlit should bind to 0.0.0.0 in containers
    command:
      ["cashsim", "ui", "--headless", "--host", "0.0.0.0", "--port", "8501"]
    environment:
      LOG_LEVEL: "INFO"
      LOG_FORMAT: "json"
      # Optional: point UI at API
      CASHSIM_API_BASE_URL: "http://api:8000"
    ports:
      - "8501:8501"

  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.141.0
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./ops/otel/otelcol-config.yaml:/etc/otelcol/config.yaml:ro
    ports:
      - "4317:4317" # OTLP gRPC
      - "4318:4318" # OTLP HTTP
      - "8889:8889" # Prometheus exporter (spanmetrics)

  jaeger:
    image: jaegertracing/all-in-one:1.55
    environment:
      COLLECTOR_OTLP_ENABLED: "true"
      METRICS_STORAGE_TYPE: "prometheus"
      PROMETHEUS_SERVER_URL: "http://prometheus:9090"
    command:
      - "--prometheus.query.support-spanmetrics-connector=true"
    ports:
      - "16686:16686" # Jaeger UI
      - "14268:14268" # HTTP thrift (optional)
      - "4319:4317" # Map Jaeger OTLP gRPC (optional local)

  prometheus:
    image: prom/prometheus:latest
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
    volumes:
      - ./ops/otel/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    ports:
      - "9090:9090"

  grafana:
    image: grafana/grafana:latest
    volumes:
      - ./ops/grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "3000:3000"
    depends_on:
      - prometheus

networks:
  default:
    name: cashsim
</file>

