    deps:
      - src/cashsim/ml/evaluate.py
      - src/cashsim/ml/features.py
      - data/synth/risk.parquet
      - artifacts/risk/model.joblib
    metrics:
      - artifacts/risk/eval/metrics.json:
          cache: false
