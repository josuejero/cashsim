<file path="pyproject.toml">
[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[project]
name = "cashsim"
version = "0.1.0"
description = "Cash flow simulator with Streamlit UI"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [{ name = "You" }]
dependencies = [
  # Core
  "pydantic>=2.10,<3",
  "pandas>=2.2.3,<3.0",          # 2.2.3+ has 3.13 wheels
  "python-dateutil>=2.9.0.post0", # relativedelta
  # UI
  "streamlit>=1.49,<2.0",
  # Streamlit dataframes use Arrow underneath; keep it modern for 3.13+ wheels.
  "pyarrow>=22,<23; python_version>='3.13'",
  "pyarrow>=12,<20; python_version<'3.13'",
  # NEW: Google Sheets integration
  "gspread>=6,<7",
  "google-auth>=2.0",
  "gspread-dataframe>=2.0.0",
  "typer>=0.12,<1.0",
  "fastapi>=0.110,<1.0",
  "uvicorn[standard]>=0.30,<1.0",
  "pydantic-settings>=2.0,<3.0",

]

[project.optional-dependencies]
dev = [
  "ruff>=0.5.0",
  "pytest>=8.2",
  "httpx>=0.27,<1.0",
  "mypy>=1.10",
  "types-python-dateutil>=2.9.0.20250822",
  "pyright",
  "pandas-stubs",
  "MonkeyType",
  "pre-commit",
  "bandit",
  "hypothesis>=6.112",
  "great-expectations>=0.18,<0.19",
  "opentelemetry-api>=1.0.0",
  "opentelemetry-sdk>=1.0.0",
  "opentelemetry-exporter-otlp>=1.0.0",
  "opentelemetry-instrumentation-fastapi>=0.40b0",

]


ml = [
  "scikit-learn>=1.5,<2",
  # mlflow pins pyarrow<20 and doesn't publish wheels for 3.13+ yet.
  "mlflow>=2.17,<3; python_version<'3.13'",
  "dvc>=3.50,<4",
  "matplotlib>=3.9,<4",
]

[project.scripts]
cashsim = "cashsim.cli:main"

[tool.ruff]
line-length = 100
target-version = "py312"
force-exclude = true

extend-exclude = ["typings/**", "**/*.pyi"]
[tool.ruff.lint]
select = [
  "E", "F",   # pyflakes/pycodestyle
  "I",        # import sorting
  "UP",       # pyupgrade
  "B",        # bugbear
  "SIM",      # flake8-simplify
  "ANN"       # type annotations
]

[tool.ruff.format]
quote-style = "double"

[tool.pyright]
# Use the src layout
venvPath = "."
venv = ".venv"
reportMissingTypeStubs = "warning"
typeCheckingMode = "strict"

[tool.hatch.build.targets.wheel]
packages = ["src/cashsim"]
sources = ["src"]

[tool.ruff.lint.flake8-annotations]
allow-star-arg-any = true

[tool.ruff.lint.per-file-ignores]
"typings/**" = ["ALL"]
"**/*.pyi" = ["ALL"]
"src/cashsim/sim/types.py" = ["UP"]
