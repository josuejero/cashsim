<file path=".github/workflows/ci.yml">
name: CI you can trust

on:
  push:
    branches: ["**"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }} (with pip cache)
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: "pip"
          cache-dependency-path: |
            pyproject.toml
            requirements*.txt

      - name: Upgrade pip
        run: python -m pip install --upgrade pip

      # Install core tooling on all versions; include hypothesis so mypy can import tests on 3.10/3.11
      - name: Install tooling (no project install on 3.10/3.11)
        run: |
          pip install ruff mypy pyright pytest hypothesis
          pip install pandas-stubs types-python-dateutil typing-extensions

      - name: Expose src/ on PYTHONPATH
        run: echo "PYTHONPATH=$GITHUB_WORKSPACE/src" >> $GITHUB_ENV

      # Only install the project on the supported version
      - name: Install project (editable) on 3.12 only
        if: matrix.python-version == '3.12'
        run: pip install -e ".[dev]"

      - name: Install runtime deps for tests (3.12 only)
        if: matrix.python-version == '3.12'
        run: pip install pandas

      - name: Ruff (lint)
        run: ruff check .

      - name: Pyright (type check)
        run: pyright

      - name: Mypy (type check)
        run: mypy .

      # Run tests only where the package can actually be installed
      - name: Pytest (3.12 only)
        if: matrix.python-version == '3.12'
        run: pytest -q
